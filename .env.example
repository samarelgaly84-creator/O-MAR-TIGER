# GEMINI_API_KEY: Required for Gemini AI API calls (TIGER AI & TIGER DRIVE AI).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL Connection Variables (Injected automatically in AI Studio Cloud SQL)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Optional Admin Bootstrap Email (comma-separated emails granted admin role on first login)
TIGER_ADMIN_EMAILS=""

# Optional Stripe Secret Key for external live card checkout verification
STRIPE_SECRET_KEY=""

# Optional comma-separated allowed CORS origins for the backend API
ALLOWED_ORIGINS=""

# Optional Web Push (VAPID) Configuration for background call & message notifications
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@tiger-platform.app"

# Optional Global TURN Relay Configuration for cross-continent WebRTC calls
METERED_DOMAIN=""
METERED_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TURN_URLS=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

